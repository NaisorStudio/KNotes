<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.knotes.app"
    android:versionCode="10"
    android:versionName="1.5.4" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!-- solo para el buscador de actualizaciones (GIST/APK); la app funciona sin internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="com.knotes.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.knotes.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.knotes.app.KNotesApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher_w"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_w"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.KNotes" >
        <activity
            android:name="com.knotes.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask" /> <!-- Ícono del lanzador: hombre (cuaderno negro con azul) -->
        <activity-alias
            android:name="com.knotes.app.ManLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_m"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_m"
            android:targetActivity="com.knotes.app.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Ícono del lanzador: mujer (cuaderno rosa) — Managed por Gender.syncLauncher -->
        <activity-alias
            android:name="com.knotes.app.WomanLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_w"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_w"
            android:targetActivity="com.knotes.app.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="com.knotes.app.EditorActivity"
            android:exported="false"
            android:screenOrientation="userPortrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Compartir diarios (pdf/png/jpg/txt) desde la caché de la app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.knotes.app.files"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.knotes.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>