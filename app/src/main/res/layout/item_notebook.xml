<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:id="@+id/cover_frame"
        android:layout_width="match_parent"
        android:layout_height="210dp">

        <com.knotes.app.ui.NotebookCoverView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btn_favorite"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_white"
            android:src="@drawable/ic_heart"
            app:tint="#EE5F8B" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_circle_white"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_chip" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:paddingHorizontal="6dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- fecha de creación bajo el nombre del diario -->
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:textColor="@color/text_dim"
        android:textSize="10sp" />

    <!-- badge de selección múltiple (✓) -->
    <TextView
        android:id="@+id/badge_sel"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_circle_white"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_chip"
        android:visibility="gone" />
</LinearLayout>
